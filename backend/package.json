{
  "name": "sra-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API + admin backend for the SRA mobile app (Fastify + MongoDB)",
  "scripts": {
    "db": "node scripts/dev-db.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "fetch:wp": "node scripts/fetch-wp.mjs",
    "import": "node --env-file-if-exists=.env scripts/import-wp.mjs",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "seed:sample": "node --env-file-if-exists=.env scripts/seed-sample.mjs",
    "copy:db": "node scripts/copy-db.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "bcryptjs": "^3.0.0",
    "cheerio": "^1.0.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
