# Copy to .env and fill in.
PORT=4000
# Local dev: run `npm run db`. Production: your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/sra
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=7d
# Used by `npm run seed:admin` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional
# CORS_ORIGIN=https://admin.sra.so
# UPLOADS_DIR=/var/data/uploads
# Optional: database name when MONGODB_URI has none (default "sra")
# MONGODB_DB=sra
# Optional: public DNS for mongodb+srv lookups if you get "querySrv ETIMEOUT"
# DNS_SERVERS=1.1.1.1,8.8.8.8
